// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}
enum GlobalRole {
  student
  teacher
  external_evaluator
}

enum ClassRole {
  student
  external_evaluator
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  globalRole   GlobalRole @map("global_role")
  createdAt    DateTime @default(now()) @map("created_at")

  // 這個人開的班（如果他是老師）
  classesTaught     Class[]       @relation("TeacherClasses")
  // 這個人加入過的班（學生或外部評議人身份）
  enrollments       Enrollment[]
  // 這個人管理的基金（經理人身份）
  managedFunds      Fund[]        @relation("FundManager")
  investorPositions InvestorPosition[] @relation("InvestorPositions")
  subscriptions     Subscription[]     @relation("InvestorSubscriptions")
  investorRatings   InvestorRating[]   @relation("InvestorRatings")
  externalEvaluations ExternalEvaluation[] @relation("ExternalEvaluations")
  talentProfiles      TalentEvidenceProfile[] @relation("TalentProfiles")

  @@map("users")
}

model Class {
  id        String   @id @default(uuid())
  teacherId String   @map("teacher_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  teacher      User          @relation("TeacherClasses", fields: [teacherId], references: [id])
  enrollments  Enrollment[]
  classCycles  ClassCycle[]
  funds        Fund[]
  talentProfiles TalentEvidenceProfile[]

  @@map("classes")
}

model Enrollment {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  classId     String    @map("class_id")
  roleInClass ClassRole @map("role_in_class")

  user  User  @relation(fields: [userId], references: [id])
  class Class @relation(fields: [classId], references: [id])

  @@unique([userId, classId])
  @@map("enrollments")
}
enum ClassCycleStatus {
  locked
  current
  done
}

model CycleTemplate {
  cycleNumber Int    @id @map("cycle_number")
  title       String
  dayNotes    Json?  @map("day_notes")

  classCycles ClassCycle[]

  @@map("cycle_templates")
}

model ClassCycle {
  id           String            @id @default(uuid())
  classId      String            @map("class_id")
  cycleNumber  Int               @map("cycle_number")
  currentDay   Int               @default(1) @map("current_day")
  status       ClassCycleStatus
  settledAt    DateTime?         @map("settled_at")

  class         Class         @relation(fields: [classId], references: [id])
  cycleTemplate CycleTemplate @relation(fields: [cycleNumber], references: [cycleNumber])

  @@unique([classId, cycleNumber])
  @@map("class_cycles")
}
enum TradeSide {
  buy
  sell
}

model Security {
  ticker String @id
  name   String

  holdings FundHolding[]
  trades   Trade[]

  @@map("securities")
}

model Fund {
  id        String   @id @default(uuid())
  classId   String   @map("class_id")
  managerId String   @map("manager_id")
  name      String
  cashBalance Decimal  @default(0) @db.Decimal(18, 4) @map("cash_balance")
  createdAt DateTime @default(now()) @map("created_at")

  class        Class             @relation(fields: [classId], references: [id])
  manager      User              @relation("FundManager", fields: [managerId], references: [id])
  holdings     FundHolding[]
  navSnapshots FundNavSnapshot[]
  trades       Trade[]
  prospectusVersions  ProspectusVersion[]
  managerStatements   ManagerStatement[]
  managerResponses    ManagerResponse[]
  investorPositions InvestorPosition[]
  subscriptions     Subscription[]
  investorRatings   InvestorRating[]
  externalEvaluations ExternalEvaluation[]

  @@map("funds")
}

model FundHolding {
  id        String    @id @default(uuid())
  fundId    String    @map("fund_id")
  ticker    String
  shares    Decimal   @db.Decimal(18, 4)
  avgCost   Decimal?  @map("avg_cost") @db.Decimal(18, 4)
  updatedAt DateTime? @updatedAt @map("updated_at")

  fund     Fund     @relation(fields: [fundId], references: [id])
  security Security @relation(fields: [ticker], references: [ticker])

  @@map("fund_holdings")
  @@unique([fundId, ticker])
}

model FundNavSnapshot {
  id                  String   @id @default(uuid())
  fundId              String   @map("fund_id")
  cycleNumber         Int      @map("cycle_number")
  day                 Int
  nav                 Decimal  @db.Decimal(18, 4)
  aum                 Decimal? @db.Decimal(18, 4)
  cash                Decimal? @db.Decimal(18, 4)
  cumulativeReturnPct Decimal? @map("cumulative_return_pct") @db.Decimal(8, 4)
  sharpe              Decimal? @db.Decimal(8, 4)
  mddPct              Decimal? @map("mdd_pct") @db.Decimal(8, 4)

  fund Fund @relation(fields: [fundId], references: [id])

  @@unique([fundId, cycleNumber, day])
  @@map("fund_nav_snapshots")
}

model Trade {
  id          String    @id @default(uuid())
  fundId      String    @map("fund_id")
  cycleNumber Int       @map("cycle_number")
  ticker      String
  side        TradeSide
  shares      Decimal   @db.Decimal(18, 4)
  price       Decimal   @db.Decimal(18, 4)
  amount      Decimal   @db.Decimal(18, 4)
  reasonNote  String?   @map("reason_note")
  createdAt   DateTime  @default(now()) @map("created_at")

  fund     Fund     @relation(fields: [fundId], references: [id])
  security Security @relation(fields: [ticker], references: [ticker])

  @@map("trades")
}
model ProspectusVersion {
  id                 String   @id @default(uuid())
  fundId             String   @map("fund_id")
  versionNo          Int      @map("version_no")
  objective          String?
  strategy           String?
  suitableInvestors  String?  @map("suitable_investors")
  createdAt          DateTime @default(now()) @map("created_at")

  fund Fund @relation(fields: [fundId], references: [id])

  @@unique([fundId, versionNo])
  @@map("prospectus_versions")
}

model ManagerStatement {
  id               String   @id @default(uuid())
  fundId           String   @map("fund_id")
  cycleNumber      Int      @map("cycle_number")
  topContributor   String?  @map("top_contributor")
  topDetractor     String?  @map("top_detractor")
  investorMessage  String?  @map("investor_message")
  createdAt        DateTime @default(now()) @map("created_at")

  fund Fund @relation(fields: [fundId], references: [id])

  @@map("manager_statements")
}

model ManagerResponse {
  id           String   @id @default(uuid())
  fundId       String   @map("fund_id")
  cycleNumber  Int      @map("cycle_number")
  questionRefId String? @map("question_ref_id")
  response     String
  createdAt    DateTime @default(now()) @map("created_at")

  fund         Fund            @relation(fields: [fundId], references: [id])
  questionRef  InvestorRating? @relation(fields: [questionRefId], references: [id])

  @@map("manager_responses")
}
enum SubscriptionType {
  subscribe
  redeem
}

model InvestorPosition {
  id         String   @id @default(uuid())
  investorId String   @map("investor_id")
  fundId     String   @map("fund_id")
  units      Decimal  @db.Decimal(18, 4)
  costBasis  Decimal? @map("cost_basis") @db.Decimal(18, 4)

  investor User @relation("InvestorPositions", fields: [investorId], references: [id])
  fund     Fund @relation(fields: [fundId], references: [id])

  @@unique([investorId, fundId])
  @@map("investor_positions")
}

model Subscription {
  id          String           @id @default(uuid())
  investorId  String           @map("investor_id")
  fundId      String           @map("fund_id")
  cycleNumber Int              @map("cycle_number")
  type        SubscriptionType
  amount      Decimal          @db.Decimal(18, 4)
  units       Decimal          @db.Decimal(18, 4)
  reasonNote  String?          @map("reason_note")
  createdAt   DateTime         @default(now()) @map("created_at")

  investor User @relation("InvestorSubscriptions", fields: [investorId], references: [id])
  fund     Fund @relation(fields: [fundId], references: [id])

  @@map("subscriptions")
}

model InvestorRating {
  id           String   @id @default(uuid())
  investorId   String   @map("investor_id")
  fundId       String   @map("fund_id")
  cycleNumber  Int      @map("cycle_number")
  questionText String?  @map("question_text")
  createdAt    DateTime @default(now()) @map("created_at")

  investor         User              @relation("InvestorRatings", fields: [investorId], references: [id])
  fund             Fund              @relation(fields: [fundId], references: [id])
  scores           RatingScore[]
  managerResponses ManagerResponse[]

  @@unique([investorId, fundId, cycleNumber])
  @@map("investor_ratings")
}

model RatingScore {
  id           String @id @default(uuid())
  ratingId     String @map("rating_id")
  criterionKey String @map("criterion_key")
  score        Int

  rating InvestorRating @relation(fields: [ratingId], references: [id])

  @@map("rating_scores")
}
enum RecommendTag {
  值得追蹤
  需要補強
}

model ExternalEvaluation {
  id             String        @id @default(uuid())
  evaluatorId    String        @map("evaluator_id")
  fundId         String        @map("fund_id")
  cycleNumber    Int           @map("cycle_number")
  fundRating     Int           @map("fund_rating")
  managerRating  Int           @map("manager_rating")
  recommendTag   RecommendTag? @map("recommend_tag")
  comment        String?
  createdAt      DateTime      @default(now()) @map("created_at")

  evaluator User @relation("ExternalEvaluations", fields: [evaluatorId], references: [id])
  fund      Fund @relation(fields: [fundId], references: [id])

  @@map("external_evaluations")
}

model TalentEvidenceProfile {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  classId      String   @map("class_id")
  generatedAt  DateTime @default(now()) @map("generated_at")

  user  User           @relation("TalentProfiles", fields: [userId], references: [id])
  class Class          @relation(fields: [classId], references: [id])
  skills SkillEvidence[]

  @@unique([userId, classId])
  @@map("talent_evidence_profiles")
}

model SkillEvidence {
  id        String @id @default(uuid())
  profileId String @map("profile_id")
  skillKey  String @map("skill_key")
  level     String

  profile TalentEvidenceProfile @relation(fields: [profileId], references: [id])

  @@map("skill_evidence")
}